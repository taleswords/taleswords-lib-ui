{
  "name": "@taleswords/lib-ui",
  "version": "2.4.1",
  "description": "Vue 3 UI component library for Taleswords",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts playground",
    "clean": "del ./dist/",
    "build": "npm run clean && vite build && vue-tsc -p tsconfig-build.json",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:boundaries": "eslint src/ --no-warn-ignored --rule '{\"no-restricted-imports\": \"error\", \"no-restricted-globals\": \"error\", \"@typescript-eslint/no-unused-vars\": \"off\"}' --max-warnings 0",
    "lint:playground": "node playground/lint-pages.mjs",
    "test:contracts": "playwright test",
    "pub": "npm version patch && npm run build && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taleswords/taleswords-lib-ui.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "library",
    "typescript"
  ],
  "author": "Taleswords",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/taleswords/taleswords-lib-ui/issues"
  },
  "homepage": "https://github.com/taleswords/taleswords-lib-ui#readme",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "del-cli": "^7.0.0",
    "eslint": "^10.0.2",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^28.0.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.3.5",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.4"
  },
  "dependencies": {
    "@fontsource-variable/lora": "^5.2.8",
    "@fontsource/source-sans-pro": "^5.2.5",
    "@material-symbols/font-400": "^0.40.2"
  }
}
